# Copy this file to .env in the project root (same folder as run.py).
# Never commit .env — it holds your personal Chicago Data Portal credentials.
#
# Required only for: python3 run.py --refresh
# Not needed to open dashboard.html (the repo includes cached data).

# 1. Create a free account: https://data.cityofchicago.org/
# 2. Sign in, open Developer Settings, and create an App Token:
#    https://data.cityofchicago.org/profile/edit/developer_settings

SOCRATA_APP_TOKEN=
SOCRATA_USERNAME=
SOCRATA_PASSWORD=

# Optional — defaults in src/pipeline/config.py match FY 2026
# BUDGET_YEAR=2026
# SOCRATA_DATASET_ORDINANCE_APPROPRIATIONS=6694-f78c
# SOCRATA_DATASET_RECOMMENDED_APPROPRIATIONS=axxr-vais
# SOCRATA_DATASET_ORDINANCE_REVENUE=nydj-5nax
